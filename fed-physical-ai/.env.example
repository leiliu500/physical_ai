# Inject completed settings from your secret manager. Do not commit credentials.
# npm start reads the process environment; Docker Compose also reads .env.
SITE_DOMAIN=control.your-organization.example
PUBLIC_ORIGIN=https://control.your-organization.example
FACILITY_ID=replace-with-authorized-facility-id
DATABASE_URL=postgresql://replace-user:replace-secret@replace-host:5432/replace-database
DATABASE_TLS=true
OIDC_ISSUER=https://identity.your-organization.example
OIDC_AUDIENCE=replace-with-resource-api-audience
OIDC_CLIENT_ID=replace-with-confidential-web-client-id
OIDC_CLIENT_SECRET=replace-with-secret-manager-value
SESSION_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# Empty registries enroll no devices or models and cannot release dispatch.
DEVICE_KEYS_JSON={}
MODEL_REGISTRY_JSON={}
# Required: supply values approved for the physical equipment. See docs/OPERATIONS.md.
SAFETY_POLICY_JSON=replace-with-approved-policy-json
TELEMETRY_MAX_AGE_SECONDS=30

# Server-side LLM planning. No API key is used; AWS SDK credentials come from a
# local profile or the ECS task role. Keep credentials outside this project.
BEDROCK_ENABLED=true
BEDROCK_REGION=us-gov-west-1
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TIMEOUT_MS=45000
